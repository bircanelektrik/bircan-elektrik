function mlzOdaEkle(gi){
  if(gi===undefined) gi=0;
  var dt=mlzState.daireTipleri[gi]; if(!dt) return;
  dt.odalar.push({ad:'Yeni Oda',priz:2,lamba:1,tv:0,data:0,islak:false});
  mlzOdaRender();
  setTimeout(function(){
    var gruplar=document.querySelectorAll('#mlz-oda-konteyner .mlz-oda-grid');
    var grup=gruplar[gi];
    if(grup){
      var kartlar=grup.querySelectorAll('.mlz-oda-card input[type="text"]');
      if(kartlar.length){ kartlar[kartlar.length-1].select(); kartlar[kartlar.length-1].focus(); }
