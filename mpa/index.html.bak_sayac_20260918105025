function mlzWaPDF(){
  if(!window._mlzPdfData){alert("Once hesaplama yapin.");return;}
  var d=window._mlzPdfData;

  // Turkce karakter donusturucu (jsPDF latin1 font siniri)
  function tr(s){
    if(s===null||s===undefined) return '';
    return String(s)
      .replace(/ç/g,'c').replace(/Ç/g,'C')
      .replace(/ğ/g,'g').replace(/Ğ/g,'G')
      .replace(/ı/g,'i').replace(/İ/g,'I')
      .replace(/ö/g,'o').replace(/Ö/g,'O')
      .replace(/ş/g,'s').replace(/Ş/g,'S')
      .replace(/ü/g,'u').replace(/Ü/g,'U')
      .replace(/—/g,'-').replace(/–/g,'-')
      .replace(/×/g,'x');
  }
  var doc=new window.jspdf.jsPDF({orientation:'p',unit:'mm',format:'a4'});
  var sayfa=1, topMarj=15, solMarj=14, sagMarj=196, genislik=182;
