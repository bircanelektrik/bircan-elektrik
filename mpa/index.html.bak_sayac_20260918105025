    doc.text('Bircan Elektrik Muhendislik  |  0534 014 09 49  |  Sayfa '+sayfa,solMarj,290);
  }
  function yeniSayfa(){
    sayfaNo(); doc.addPage(); sayfa++; y=topMarj;
  }
  function yKontrol(yuk){if(y+yuk>276){yeniSayfa();}}

