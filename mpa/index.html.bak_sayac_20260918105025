   Villa'da her kat kendi oda listesini taşır (villa her katta aynı
   değildir) — zemin kat, 1. kat, 2. kat ayrı bloklar halinde açılır. */
function mlzVillaKatlariOlustur(){
  var isimler=['Zemin Kat','1. Kat','2. Kat'];
