  else if(mlzState.binaTip==='villa') baslik='<div style="font-size:13px;font-weight:700;margin-bottom:8px;color:var(--gold);">'+dt.tip+'</div>';
  var zorunluAktif=mlzZorunluAktifMi(gi);
