/* ── ODA LİSTESİ ──
   Tipik oda dağılımı (saha/pazar pratiği):
   1+1: Yatak Odası (tek), Salon yok.
   2+1: Ebeveyn Yatak Odası + Çocuk Odası, Salon yok (küçük dairede
        oturma alanı mutfakla birleşik varsayılır).
   3+1: Salon + Ebeveyn Yatak Odası + Çocuk Odası.
   4+1: 3+1'e ek olarak Çalışma Odası.
   5+1: 4+1'e ek olarak Misafir Odası (ve otomatik 2. Banyo zaten y>=4'te ekleniyor).
   Daha fazla yatak/oda ihtiyacı olursa "+ Oda Ekle" ile elle eklenir. */
function mlzOdaListesi(tip){
  var y=parseInt(tip); if(isNaN(y))y=3;
  var o=[];
  if(y>=3) o.push({ad:'Salon',priz:2,lamba:3,tv:1,data:0,islak:false});

  var yatakSay=Math.min(y,2);
  for(var i=0;i<yatakSay;i++){
    var yad = y===1 ? 'Yatak Odası' : (i===0?'Ebeveyn Yatak Odası':'Çocuk Odası');
    o.push({ad:yad,priz:2,lamba:3,tv:0,data:0,islak:false});
  }
  if(y>=4) o.push({ad:'Çalışma Odası',priz:2,lamba:3,tv:0,data:1,islak:false});
  if(y>=5) o.push({ad:'Misafir Odası',priz:2,lamba:3,tv:0,data:0,islak:false});

  o.push({ad:'Mutfak',priz:5,lamba:3,tv:0,data:0,islak:false});
  o.push({ad:'Banyo',priz:1,lamba:1,tv:0,data:0,islak:true});
  o.push({ad:'WC',priz:1,lamba:1,tv:0,data:0,islak:true});
  if(y>=4) o.push({ad:'2. Banyo',priz:1,lamba:1,tv:0,data:0,islak:true});
  o.push({ad:'Koridor',priz:1,lamba:3,tv:0,data:1,islak:false});
  o.push({ad:'Balkon',priz:1,lamba:1,tv:0,data:0,islak:true});
  return o;
}

