function mlzKesitSec(akim, malzeme){
  var tablo=malzeme==='bakir'?MLZ.nyy_kapasite:MLZ.nayy_kapasite;
  for(var i=0;i<tablo.length;i++){if(tablo[i].a>=akim)return tablo[i];}
  return tablo[tablo.length-1];
}
function mlzNymSec(akim){
  for(var i=0;i<MLZ.nym_kapasite.length;i++){if(MLZ.nym_kapasite[i].a>=akim)return MLZ.nym_kapasite[i];}
  return MLZ.nym_kapasite[MLZ.nym_kapasite.length-1];
}
function mlzAerSec(akim){
  for(var i=0;i<MLZ.aer_kapasite.length;i++){if(MLZ.aer_kapasite[i].a>=akim)return MLZ.aer_kapasite[i];}
  return MLZ.aer_kapasite[MLZ.aer_kapasite.length-1];
}
function mlzBeslemeSec(akim, hatTip, kolonMat, trifaze){
  var damar=trifaze?'4':'2';
  if(hatTip==='havai' && kolonMat==='aluminyum'){
    var k=mlzAerSec(akim); return {label:'AER '+k.mm+' (havai alüminyum)',mm:k.mm,a:k.a};
  }
  if(hatTip==='havai' && kolonMat==='bakir'){
    var k=mlzNymSec(akim); return {label:'NYM '+damar+'×'+k.mm+'mm² (havai bakır)',mm:k.mm,a:k.a};
  }
  if(hatTip==='yeralti' && kolonMat==='bakir'){
    var k=mlzKesitSec(akim,'bakir'); return {label:'NYY '+damar+'×'+k.mm+'mm² (yeraltı bakır)',mm:k.mm,a:k.a};
  }
  var k=mlzKesitSec(akim,'aluminyum'); return {label:'NAYY '+damar+'×'+k.mm+'mm² (yeraltı alüminyum)',mm:k.mm,a:k.a};
}
/* TMS artik hesaplanan bina akimina uste yuvarlanarak degil, ana besleme
   kablosunun tasima kapasitesine (Iz) gore koruma koordinasyonuyla
   seciliyor: In, Iz'yi asmayan en buyuk standart deger (Ib <= In <= Iz).
   Saha/proje onayli ornek: 3x35/16+16 NYY (Iz=143A) -> In=125A. Cagri
   yeri besleme kablosu belirlendikten SONRA (bkz. mlzHesapla). */
function mlzTmsSec(kabloAkim, minAkim){
  var secilen=MLZ.tms_std[0];
  for(var i=0;i<MLZ.tms_std.length;i++){
    if(MLZ.tms_std[i]<=kabloAkim) secilen=MLZ.tms_std[i]; else break;
  }
  if(minAkim!==undefined && secilen<minAkim){
    for(var j=0;j<MLZ.tms_std.length;j++){if(MLZ.tms_std[j]>=minAkim){secilen=MLZ.tms_std[j];break;}}
  }
  return secilen;
}

/* ── EŞ ZAMANLILIK ── */
function mlzEszKatsayi(daireSay){
  if(daireSay<=2) return 0.60;
  for(var i=0;i<MLZ_ESZ.length;i++){if(daireSay>=MLZ_ESZ[i].min&&daireSay<=MLZ_ESZ[i].max)return MLZ_ESZ[i].k;}
  return 0.23;
}
function mlzEszMustakil(gucW){
  if(gucW<=8000) return gucW*0.6;
  return 8000*0.6+(gucW-8000)*0.4;
}

/* ── ANAHTAR/KASA DAĞILIMI ──
   Piyasada 4'lü anahtar bulunmadığı için bir odadaki N adet aydınlatma
   devresi en fazla 3'lü gruplar halinde ayrı kasalara bölünür:
   4 devre → 1 kasa 3'lü + 1 kasa tekli; 6 devre → 2 kasa 3'lü;
   8 devre → 2 kasa 3'lü + 1 kasa ikili. */
function mlzAnahtarKasaHesapla(n){
  if(n<=0) return {kasa:0,uclu:0,ikili:0,tekli:0};
  var uclu=Math.floor(n/3), kalan=n%3, ikili=0, tekli=0;
  if(kalan===2) ikili=1; else if(kalan===1) tekli=1;
  return {kasa:uclu+(kalan>0?1:0), uclu:uclu, ikili:ikili, tekli:tekli};
}

/* Bir oda listesini (tek kat veya tek daire) tek bir agregasyona toplar. */
function mlzOdaAgregasyonTopla(odalar){
  var a={tPriz:0,tIslakPriz:0,tLamba:0,tTV:0,tData:0,lambaDevreSay:0,islakDevreSay:0,
    anahtarKasaSay:0,anahtarUclu:0,anahtarIkili:0,anahtarTekli:0,odaSayisi:odalar.length};
  odalar.forEach(function(o){
    if(o.islak){a.tIslakPriz+=o.priz;} else {a.tPriz+=o.priz;}
    a.tLamba+=o.lamba; a.tTV+=(o.tv||0); a.tData+=(o.data||0);
    /* Aydınlatma devre sayısı: WC/Banyo/Balkon 1 devre (basit),
       diğer tüm odalar (Salon, Mutfak, Koridor, Yatak Odaları vb.) 3 merkezi
       + 1 gizli/indirekt ışık = 4 devre. (Bircan Elektrik saha uygulaması) */
    var basitMi=/^(WC|Banyo|Balkon)/i.test(o.ad);
    var devre=basitMi?1:4;
    a.lambaDevreSay+=devre;
    if(o.islak) a.islakDevreSay+=devre; // ıslak zemindeki buata giden tevzi hattı topraklı olmalı
    var kh=mlzAnahtarKasaHesapla(devre);
    a.anahtarKasaSay+=kh.kasa; a.anahtarUclu+=kh.uclu; a.anahtarIkili+=kh.ikili; a.anahtarTekli+=kh.tekli;
  });
  return a;
}

/* Daire panosu boyutunu (modül) MCB sayısı + RCD'nin kapladığı modülden
   hesaplar. RCD, tek fazlı (2P) ise 2 modül, üç fazlı (4P) ise 4 modül
   genişliğindedir — bu ayrım gözden kaçarsa pano bir standart küçük
   çıkabilir (ör. 14 modül ihtiyacı 12'lik panoya sığdırılmaya çalışılır). */
function mlzPanoModHesapla(mcbSayisi, trifaze){
  var rcdModul = trifaze ? 4 : 2;
  var topMcb = mcbSayisi + rcdModul;
  return topMcb<=12?12:topMcb<=18?18:topMcb<=24?24:topMcb<=36?36:topMcb<=48?48:54;
}

/* Bir agregasyon + cihaz listesinden tek bir "daire/kat grubu" sonucu üretir.
   Villa'da tüm katların agregasyonu toplanıp buraya TEK sefer gönderilir
   (villa tek konuttur, tek sayaç/tek pano); apartman/müstakilde her daire
   tipi kendi agregasyonuyla ayrı ayrı buraya gelir. */
function mlzDaireHesaplaTek(a, cihazlar, tip, adet, mesafeOlcek){
  if(mesafeOlcek===undefined || isNaN(mesafeOlcek)) mesafeOlcek=1;
  var tPriz=a.tPriz, tIslakPriz=a.tIslakPriz, tLamba=a.tLamba, tTV=a.tTV, tData=a.tData;
  var lambaDevreSay=a.lambaDevreSay, islakDevreSay=a.islakDevreSay;

  /* Bina taban ölçüsüne göre ölçeklenen kablo mesafe sabitleri — bkz. MLZ
     tanımındaki kablo_baz_alan açıklaması. Sadece odaya/panoya giden kablo
     UZUNLUĞUNU temsil eden sabitler ölçeklenir; priz/lamba sayısı, güç,
     MCB/hat gruplama gibi sayım tabanlı değerler etkilenmez. */
  var k_lamba_faz=MLZ.kablo_lamba_faz*mesafeOlcek;
  var k_lamba_notr=MLZ.kablo_lamba_notr*mesafeOlcek;
  var k_priz=MLZ.kablo_priz*mesafeOlcek;
  var k_linye=MLZ.aydinlatma_linye*mesafeOlcek;
  var k_mustakil=MLZ.kablo_mustakil*mesafeOlcek;

  var prizGuc=(tPriz+tIslakPriz)*MLZ.watt_priz, lambaGuc=tLamba*MLZ.watt_lamba;
  var cihazGuc=cihazlar.reduce(function(s,c){return s+c.watt;},0);
  var daireGuc=Math.round((prizGuc+lambaGuc+cihazGuc)*MLZ.emniyet);

  var prizHat=Math.ceil((tPriz+tIslakPriz)/MLZ.max_priz_hat);

  /* Pano MCB sayısı: bir hat/linyeye maks 7 priz, maks 8 aydınlatma devresi
     bağlanabilir (saha kuralı) — her oda-devresi için ayrı MCB AÇILMAZ,
     devreler bu limitlere göre ortak hatlara/MCB'lere gruplanır. Kablo
     metrajı (siyah25 vb.) hâlâ gerçek devre sayısına göre hesaplanır çünkü
     her devrenin kendi buata giden teli vardır — sadece pano/MCB sayısı
     gruplanır. */
  var aydinlatmaHat=Math.ceil(lambaDevreSay/MLZ.max_lamba_hat);
  var mcbs=[];
  for(var i=0;i<aydinlatmaHat;i++) mcbs.push({tip:'1P',a:'10A',acl:'Aydınlatma '+(i+1)});
  for(var j=0;j<prizHat;j++) mcbs.push({tip:'1P',a:'16A',acl:'Priz '+(j+1)});
  cihazlar.forEach(function(c){
    var mcbA=c.watt>MLZ.mustakil_esik?'25A':'16A';
    mcbs.push({tip:'1P',a:mcbA,acl:c.ad});
  });

  /* ── Renk bazlı tekli damar tel miktarları — saha referans ölçümlerine göre
     kalibre edildi (Eylül 2026). Faz ve nötr artık EŞİT uzunlukta değil:
     faz teli anahtar/kutu üzerinden dolaştığı için daha uzun, nötr daha
     kısa/doğrudan gider — bu yüzden her renk kendi katsayısıyla hesaplanır.
     Villa'da katlar artık gerçek oda verisiyle toplandığı için ayrı bir
     kat çarpanına gerek kalmadı. */
  var kirmizi15=Math.round(tLamba*k_lamba_faz*MLZ.emniyet);   // aydınlatma sortisi — faz
  var mavi15=Math.round(tLamba*k_lamba_notr*MLZ.emniyet);     // aydınlatma sortisi — nötr
  var kirmizi25=Math.round((tPriz+tIslakPriz)*k_priz*MLZ.emniyet); // priz fazı
  var siyah25=Math.round(lambaDevreSay*k_linye);         // aydınlatma linyesi (tevzi) fazı
  var siyah25Islak=Math.round(islakDevreSay*k_linye);    // linyenin ıslak zemine giden kısmı (toprak payı için)
  var kahve25=0, kahve4=0;
  cihazlar.forEach(function(c){
    if(c.watt>MLZ.mustakil_esik){kahve4+=k_mustakil;}else{kahve25+=k_mustakil;}
  });
  /* kahve25/kahve4 birden fazla cihazın ondalıklı k_mustakil değerlerinin
     toplamıdır (örn. 16.25×3=48.75) — malzeme listesinde küsuratlı metre
     görünmemesi için burada tam sayıya yuvarlanır. */
  kahve25=Math.round(kahve25); kahve4=Math.round(kahve4);
  var mavi25=Math.round(MLZ.notr_orani*(kirmizi25+siyah25+kahve25));            // ortak nötr (paylaşılan/baralanmış hat)
  var sariyesil25=Math.round(MLZ.toprak_orani*(kirmizi25+kahve25+siyah25Islak)); // priz+müstakil+ıslak linye toprağı
  var mavi4=kahve4, sariyesil4=kahve4;

  /* Güzergah (route/boru-buat) uzunlukları — faz tellerinin üzerinden hesaplanır */
  var k15=kirmizi15;
  var k25=kirmizi25+siyah25+kahve25;
  var k4=kahve4;

  var eszGuc=mlzEszMustakil(daireGuc);
  var daireAkim=eszGuc/220;

  /* Pano boyutu (modül) burada KESİNLEŞTİRİLEMEZ: kaçak akım rölesinin
     (RCD) kaç modül genişliğinde olacağı binanın tek fazlı mı yoksa üç
     fazlı mı besleneceğine (trifaze) bağlıdır — bu ise TÜM dairelerin
     toplam eşdeğer gücü hesaplanana kadar bilinmez (bkz. mlzHesapla).
     2P (tek fazlı) RCD 2 modül, 4P (üç fazlı) RCD 4 modül genişliğindedir.
     Bu yüzden panoMod, mlzHesapla içinde trifaze belirlendikten SONRA
     mlzPanoModHesapla() ile her daire için ayrıca hesaplanıp üzerine
     yazılır; burada sadece MCB listesi (mcbs) döndürülür. */
  var panoMod=12; // geçici; mlzHesapla trifaze belirlendikten sonra günceller

  var boru=Math.round((k15+k25+k4)*MLZ.boru_k);
  var buat=a.odaSayisi*MLZ.buat_oda;

  return {
    tip:tip, adet:adet,
    priz:tPriz, islakPriz:tIslakPriz, lamba:tLamba, tv:tTV, data:tData,
    guc:daireGuc, eszGuc:Math.round(eszGuc), akim:Math.round(daireAkim*10)/10,
    mcbs:mcbs, panoMod:panoMod,
    k15:k15, k25:k25, k4:k4, boru:boru, buat:buat,
    kirmizi15:kirmizi15, mavi15:mavi15,
    kirmizi25:kirmizi25, mavi25:mavi25, sariyesil25:sariyesil25, kahve25:kahve25, siyah25:siyah25,
    mavi4:mavi4, sariyesil4:sariyesil4,
    anahtarToplam:lambaDevreSay, anahtarKasa:a.anahtarKasaSay,
    anahtarUclu:a.anahtarUclu, anahtarIkili:a.anahtarIkili, anahtarTekli:a.anahtarTekli,
    cihazSayisi:cihazlar.length
  };
}

/* ══════════════════════════════════════════
   ANA HESAPLAMA MOTORU
   ══════════════════════════════════════════ */
function mlzHesapla(){
  var S=mlzState, isBina=S.binaTip==='apartman';
  if(!S.binaTip){alert('Önce bina tipini seçin.');return;}
  var katSay=S.katSay, direkM=parseInt(document.getElementById('mlz-direk').value)||10;

  /* Bina taban ölçüsü (eni×boyu) — topraklama çevre hesabında zaten
     kullanılıyordu; artık daire içi kablo metrajı sabitlerini de
     ölçeklemek için en başta okunuyor (bkz. MLZ.kablo_baz_alan). Ölçek
     sadece taban ALANINA (tA*tB) bağlıdır, eni/boy oranına değil. */
  var tA=parseInt(document.getElementById('mlz-bina-a').value)||10;
  var tB=parseInt(document.getElementById('mlz-bina-b').value)||10;
  var mesafeOlcek=Math.sqrt((tA*tB)/MLZ.kablo_baz_alan);
  if(mesafeOlcek<MLZ.kablo_olcek_min) mesafeOlcek=MLZ.kablo_olcek_min;
  if(mesafeOlcek>MLZ.kablo_olcek_max) mesafeOlcek=MLZ.kablo_olcek_max;

  // Daire bazlı hesaplar
  var topDaire=0, daireSonuclar=[], tumCihazlar=[];
  if(S.binaTip==='villa'){
    /* Villa: her kat kendi oda listesini taşır ama tek konut/tek pano
       olarak hesaplanır — katların agregasyonu toplanıp TEK sefer
       mlzDaireHesaplaTek'e gönderilir. */
    var vAgg={tPriz:0,tIslakPriz:0,tLamba:0,tTV:0,tData:0,lambaDevreSay:0,islakDevreSay:0,
      anahtarKasaSay:0,anahtarUclu:0,anahtarIkili:0,anahtarTekli:0,odaSayisi:0};
    var vCihazlar=[];
    S.daireTipleri.forEach(function(dt,di){
      var cihazlar=mlzDtCihazlari(dt,mlzZorunluAktifMi(di));
      dt.cihazlarListesi=cihazlar;
      vCihazlar=vCihazlar.concat(cihazlar);
      var a=mlzOdaAgregasyonTopla(dt.odalar);
      vAgg.tPriz+=a.tPriz; vAgg.tIslakPriz+=a.tIslakPriz; vAgg.tLamba+=a.tLamba;
      vAgg.tTV+=a.tTV; vAgg.tData+=a.tData; vAgg.lambaDevreSay+=a.lambaDevreSay;
      vAgg.islakDevreSay+=a.islakDevreSay; vAgg.anahtarKasaSay+=a.anahtarKasaSay;
      vAgg.anahtarUclu+=a.anahtarUclu; vAgg.anahtarIkili+=a.anahtarIkili; vAgg.anahtarTekli+=a.anahtarTekli;
      vAgg.odaSayisi+=a.odaSayisi;
    });
    tumCihazlar=tumCihazlar.concat(vCihazlar);
    daireSonuclar.push(mlzDaireHesaplaTek(vAgg, vCihazlar, 'Villa ('+S.katSay+' kat)', 1, mesafeOlcek));
    topDaire=1;
  } else {
    S.daireTipleri.forEach(function(dt){
      // Cihazlar — artık her daire tipi kendi seçimini taşır
      var cihazlar=mlzDtCihazlari(dt,true);
      dt.cihazlarListesi=cihazlar;
      tumCihazlar=tumCihazlar.concat(cihazlar);
      var a=mlzOdaAgregasyonTopla(dt.odalar);
      daireSonuclar.push(mlzDaireHesaplaTek(a, cihazlar, dt.tip, dt.adet, mesafeOlcek));
      topDaire+=dt.adet;
    });
  }

  /* ── BİNA GENELİ EŞ ZAMANLI GÜÇ ──
     İki kademeli hesaplanır (SMM/proje pratiği):
       1) HER DAİRE için kurulu gücün ilk 8000 W'ı × 0,60, kalanı × 0,40
          (mlzEszMustakil) → dairenin kendi eş zamanlı gücü.
       2) Bu değerlerin daire adetleriyle çarpılıp toplanmış hali, TOPLAM
          DAİRE SAYISINA göre tablodan gelen katsayıyla (MLZ_ESZ) bir kez
          daha çarpılır.
     Önceden 1. kademe atlanıyor, kurulu güç DOĞRUDAN tablo katsayısıyla
     çarpılıyordu — bu eş zamanlı gücü belirgin şekilde yüksek gösteriyordu.
     Doğrulama (saha projesi, 10 daireli bina):
       11.352 W daire → 8000×0,60 + 3352×0,40 = 6.141 W; ×5 = 30.705 W
       14.806 W daire → 8000×0,60 + 6806×0,40 = 7.522 W; ×5 = 37.610 W
       (30.705 + 37.610) × 0,43 = 29.375 W  ← projedeki değerle birebir. */
  var topKuruluGuc=0, topDaireEszGuc=0, topEszGuc=0;
  daireSonuclar.forEach(function(d){
    topKuruluGuc+=d.guc*d.adet;
    topDaireEszGuc+=d.eszGuc*d.adet;
  });
  if(isBina){
    var eszK=mlzEszKatsayi(topDaire);
    topEszGuc=Math.round(topDaireEszGuc*eszK);
  } else {
    topEszGuc=daireSonuclar[0]?daireSonuclar[0].eszGuc:0;
  }

  // Asansör
  var asansorGuc=0, asansorAkim=0;
  if(S.asansor && isBina){
    asansorGuc=Math.round(katSay*MLZ.asansor_kw_kat*1000);
    asansorAkim=Math.round(asansorGuc/(1.732*380)*10)/10;
    topEszGuc+=asansorGuc;
  }

  var trifaze=topEszGuc>5000;
  var voltaj=trifaze?380:220;
  /* Ana giris hatti akimi cosfi=0,9 kabulu (KCETAS baglanti hatti
     projelerindeki pratikle ortussun diye) ve 400V nominal gerilimle
     hesaplaniyor -- saha ornegi: 58.135 W / (1,732x400x0,9) = 93,3 A,
     onayli projedeki degerle birebir. */
  var MLZ_COSFI=0.9;
  var binaAkim;
  if(trifaze){binaAkim=topEszGuc/(1.732*400*MLZ_COSFI);}else{binaAkim=topEszGuc/(220*MLZ_COSFI);}
  binaAkim=Math.round(binaAkim*10)/10;

  /* Daire panosu boyutları artık trifaze belirlendiğine göre kesinleştirilir
     (bkz. mlzDaireHesaplaTek içindeki not — RCD 2P/4P modül genişliği). */
  daireSonuclar.forEach(function(d){
    d.panoMod = mlzPanoModHesapla(d.mcbs.length, trifaze);
  });

  // İç kolon
  var kolonDamar=trifaze?'4':'2';
  var kolonSonuclar=[];
  var maxKolonKesit=MLZ.kolon_min;
  if(isBina){
    daireSonuclar.forEach(function(d){
      var dAkim=trifaze?d.eszGuc/(1.732*380):d.eszGuc/220;
      dAkim=Math.round(dAkim*10)/10;
      var kKesit=mlzKesitSec(dAkim,'bakir');
      if(kKesit.mm<MLZ.kolon_min) kKesit={mm:MLZ.kolon_min,a:47};
      if(kKesit.mm>maxKolonKesit) maxKolonKesit=kKesit.mm;
      var ortaKat=Math.ceil(katSay/2);
      var kM=Math.round((ortaKat*MLZ.kat_h+MLZ.kolon_ek)*d.adet);
      kolonSonuclar.push({tip:d.tip,adet:d.adet,kesit:kKesit.mm,damar:kolonDamar,metre:kM,akim:dAkim});
    });
  } else {
    var dAkim=trifaze?topEszGuc/(1.732*380):topEszGuc/220;
    dAkim=Math.round(dAkim*10)/10;
    var kKesit=mlzKesitSec(dAkim,'bakir');
    if(kKesit.mm<MLZ.kolon_min) kKesit={mm:MLZ.kolon_min,a:47};
    if(kKesit.mm>maxKolonKesit) maxKolonKesit=kKesit.mm;
    var kM=MLZ.ic_kolon+(S.binaTip==='villa'?(S.katSay*MLZ.kat_h):0);
    kolonSonuclar.push({tip:'Kolon',adet:1,kesit:kKesit.mm,damar:kolonDamar,metre:Math.round(kM),akim:dAkim});
  }

  // Besleme
  var maxKolonAkimKap=0;
  kolonSonuclar.forEach(function(k){
    for(var i=0;i<MLZ.nyy_kapasite.length;i++){
      if(MLZ.nyy_kapasite[i].mm===k.kesit){
        if(MLZ.nyy_kapasite[i].a>maxKolonAkimKap) maxKolonAkimKap=MLZ.nyy_kapasite[i].a;
        break;
      }
    }
  });
  var besMinAkim=Math.max(binaAkim, maxKolonAkimKap);
  var besleme=mlzBeslemeSec(besMinAkim, S.hatTip, S.kolonMat, trifaze);
  var tms=mlzTmsSec(besleme.a, binaAkim);
  var besM=direkM+5;

  // Ortak alan
  var ortakK15=0,ortakLamba=0,ortakAnahtar=0;
  if(isBina){
    ortakLamba=katSay*MLZ.ortak_lamba_kat+MLZ.ortak_giris;
    ortakK15=katSay*MLZ.ortak_kablo_kat;
    ortakAnahtar=1;
  }

  // Asansör kuyu
  var asanKuyu={lamba:0,buton:0,priz:0,darbeli:0,kablo:0};
  if(S.asansor && isBina){
    asanKuyu.lamba=katSay; asanKuyu.buton=katSay; asanKuyu.darbeli=1;
    asanKuyu.priz=2+Math.floor(katSay/3);
    asanKuyu.kablo=Math.round(katSay*MLZ.kat_h+5);
  }

  // Diyafon
  var diyMalz=[];
  var saftKabloM=isBina?Math.round(katSay*MLZ.kat_h+5):5;
  var daireyeKabloM=isBina?Math.round(topDaire*4):4;
  if(S.diyafon==='zil'){
    diyMalz.push(
      {m:'Kapı zili',a:isBina?topDaire:1},
      {m:'Zil butonu',a:isBina?topDaire:1},
      {m:'NYM 2×0.75 kablo',a:(isBina?(topDaire*5+katSay*3):5)+' m'}
    );
  } else if(S.diyafon==='ahize'){
    diyMalz.push(
      {m:'Dış panel / giriş ünitesi',a:1},
      {m:'Güç kaynağı / PSU',a:1},
      {m:'İç ünite ahize',a:isBina?topDaire:1},
      {m:'Light buton (daire başı)',a:isBina?topDaire:1},
      {m:'DT8 şaft kablo',a:saftKabloM+' m'},
      {m:'DT8 şaftan daireye kablo',a:daireyeKabloM+' m'}
    );
  } else {
    diyMalz.push(
      {m:'Dış panel (kameralı)',a:1},
      {m:'Güç kaynağı / PSU',a:1},
      {m:'İç ünite monitor',a:isBina?topDaire:1},
      {m:'Light buton (daire başı)',a:isBina?topDaire:1},
      {m:'CAT6 şaft kablo (sinyal)',a:saftKabloM+' m'},
      {m:'CAT6 şaftan daireye kablo',a:daireyeKabloM+' m'},
      {m:'NYM 2×0.75 besleme kablosu',a:saftKabloM+' m'}
    );
  }

  // Kamera
  var kamMalz=[];
  if(S.kamera>0){
    kamMalz.push(
      {m:'IP Kamera',a:S.kamera},
      {m:'Talep edilen kayıt süresi',a:S.kameraGun+' gün'}
    );
  }

  // Max iç tesisat akımı
  var maxIcAkim=0, maxIcCihaz='Priz hattı (16A)';
  tumCihazlar.forEach(function(c){var ca=c.watt/220;if(ca>maxIcAkim){maxIcAkim=ca;maxIcCihaz=c.ad;}});
  if(maxIcAkim<16){maxIcAkim=16;maxIcCihaz='Priz hattı';}
  maxIcAkim=Math.round(maxIcAkim*10)/10;

  /* ═══ SONUÇ HTML ═══ */
  var html='';
  function tbl(baslik,rows){
    var t='<div class="mlz-sonuc-grup"><div class="mlz-sonuc-baslik">'+baslik+'</div><table class="mlz-sonuc-tablo"><tbody>';
    rows.forEach(function(r){t+='<tr><td>'+r[0]+'</td><td style="text-align:right;font-weight:600;">'+r[1]+'</td></tr>';});
    return t+'</tbody></table></div>';
  }

  // Özet
  html+='<div class="mlz-ozet-kutu">';
  html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+(topKuruluGuc/1000).toFixed(1)+'</div><div class="mlz-ozet-lbl">Kurulu Güç (kW)</div></div>';
  html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+(topEszGuc/1000).toFixed(1)+'</div><div class="mlz-ozet-lbl">Eş Zamanlı (kW)</div></div>';
  html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+(trifaze?'3 Faz':'Mono')+'</div><div class="mlz-ozet-lbl">Sistem ('+voltaj+'V)</div></div>';
  html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+binaAkim+'A</div><div class="mlz-ozet-lbl">Besleme Akımı</div></div>';
  if(isBina) html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+topDaire+'</div><div class="mlz-ozet-lbl">Toplam Daire</div></div>';
  html+='<div class="mlz-ozet-item"><div class="mlz-ozet-val">'+maxIcAkim+'A</div><div class="mlz-ozet-lbl">Max İç Tesisat</div></div>';
  html+='</div>';

  // ADP
  var adpRows=[['Kofre','1 adet']];
  adpRows.push(['TMŞ '+tms+'A','1 adet']);
  adpRows.push(['Sayaç ('+(trifaze?'3 Faz':'Monofaze')+')',topDaire+' adet']);
  if(isBina) adpRows.push(['Sayaç (Ortak Alan)','1 adet']);
  if(S.asansor && isBina) adpRows.push(['Sayaç (Asansör)','1 adet']);
  var ekSayac=(isBina?1:0)+((S.asansor&&isBina)?1:0);
  if(ekSayac>0) adpRows.push(['Toplam Sayaç',(topDaire+ekSayac)+' adet']);
  adpRows.push([(trifaze?'4P':'2P')+' RCD 40A 300mA (daire başı)',topDaire+' adet']);
  daireSonuclar.forEach(function(d){
    var dKolonAkim=trifaze?d.eszGuc/(1.732*380):d.eszGuc/220;
    dKolonAkim=Math.round(dKolonAkim*10)/10;
    var mcbA=MLZ.mcb_std.find(function(v){return v>=dKolonAkim;})||32;
    if(mcbA<32) mcbA=32;
    adpRows.push([(trifaze?'4P':'2P')+' MCB '+mcbA+'A — '+d.tip,d.adet+' adet']);
  });
  if(isBina){
    adpRows.push(['Ortak alan '+(trifaze?'4P':'2P')+' RCD 40A 300mA','1 adet']);
    adpRows.push(['Ortak alan MCB 10A','1 adet']);
  }
  if(S.asansor && isBina){
    adpRows.push(['Asansör 4P RCD 40A 300mA','1 adet']);
    var asanMcb=MLZ.mcb_std.find(function(v){return v>=asansorAkim;})||32;
    if(asanMcb<32) asanMcb=32;
    adpRows.push(['Asansör 4P MCB '+asanMcb+'A','1 adet']);
  }
  html+=tbl('⚡ Ana Dağıtım Panosu (ADP)',adpRows);

  // Daire panoları
  daireSonuclar.forEach(function(d){
    var pRows=[];
    pRows.push(['Pano boyutu',d.panoMod+' modül']);
    pRows.push([(trifaze?'4P':'2P')+' RCD 30mA 25A','1 adet']);
    var mcbGrup={};
    d.mcbs.forEach(function(m){
      var ampVal=parseInt(m.a);
      var key=(ampVal>25?'25A':m.a);
      if(!mcbGrup[key]) mcbGrup[key]={a:key,adet:0,acl:[]};
      mcbGrup[key].adet++;
      if(mcbGrup[key].acl.indexOf(m.acl)===-1) mcbGrup[key].acl.push(m.acl);
    });
    Object.keys(mcbGrup).forEach(function(k){
      var g=mcbGrup[k];
      var acl=g.acl.length<=2?g.acl.join(', '):(g.acl.slice(0,2).join(', ')+' vb.');
      pRows.push(['1P MCB '+g.a+' — '+acl, g.adet+' adet']);
    });
    html+=tbl('🏠 Daire Panosu — '+d.tip+' ('+d.adet+' adet)',pRows);
  });

  // Kablolar — besleme & kolon
  var kabloRows=[];
  kabloRows.push([besleme.label, besM+' m']);
  kolonSonuclar.forEach(function(k){
    kabloRows.push(['NYY '+k.damar+'×'+k.kesit+'mm² (iç kolon — '+k.tip+')',k.metre+' m']);
  });
  html+=tbl('🔌 Kablolar — Besleme & Kolon',kabloRows);

  // Kablolar — daire içi (tek damarlı, renk kodlu tesisat teli)
  var dicRows=[];
  var topK15=0,topK25=0,topK4=0,topBoru=0,topBuat=0,topPriz=0,topIslak=0,topLamba=0,topAnahtar=0,topTV=0,topData=0;
  var topKirmizi15=0,topMavi15=0,topKirmizi25=0,topMavi25=0,topSariyesil25=0,topKahve25=0,topSiyah25=0,topMavi4=0,topSariyesil4=0;
  var topAnahtarKasa=0,topAnahtarUclu=0,topAnahtarIkili=0,topAnahtarTekli=0,topMustakilPriz=0;
  daireSonuclar.forEach(function(d){
    topK15+=d.k15*d.adet; topK25+=d.k25*d.adet; topK4+=d.k4*d.adet;
    topBoru+=d.boru*d.adet; topBuat+=d.buat*d.adet;
    topPriz+=d.priz*d.adet; topIslak+=d.islakPriz*d.adet;
    topLamba+=d.lamba*d.adet; topAnahtar+=d.anahtarToplam*d.adet;
    topAnahtarKasa+=d.anahtarKasa*d.adet; topAnahtarUclu+=d.anahtarUclu*d.adet;
    topAnahtarIkili+=d.anahtarIkili*d.adet; topAnahtarTekli+=d.anahtarTekli*d.adet;
    topMustakilPriz+=d.cihazSayisi*d.adet;
    topTV+=(d.tv||0)*d.adet; topData+=(d.data||0)*d.adet;
    topKirmizi15+=d.kirmizi15*d.adet; topMavi15+=d.mavi15*d.adet;
    topKirmizi25+=d.kirmizi25*d.adet; topMavi25+=d.mavi25*d.adet;
    topSariyesil25+=d.sariyesil25*d.adet; topKahve25+=d.kahve25*d.adet; topSiyah25+=d.siyah25*d.adet;
    topMavi4+=d.mavi4*d.adet; topSariyesil4+=d.sariyesil4*d.adet;
